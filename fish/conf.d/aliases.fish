alias which 'type' # better results using 'type' builtin

# ls
alias l 'ls --header --long'
alias lm 'ls --header --long --sort=modified'
alias ll 'ls --all --header --long'
alias llm 'ls --all --header --long --sort=modified'
alias tree 'ls --tree'
alias la 'eza -lbhHigUmuSa'
alias lx 'eza -lbhHigUmuSa@'
