# left prompt
set -g tide_left_prompt_items pwd vcs newline character
set -g tide_left_prompt_frame_enabled true
set -g tide_left_prompt_prefix ' '

# character
set -g tide_character_icon '❯❯'

# git
set -g tide_git_icon ''
set -g tide_git_branch 'green'
set -g tide_git_truncation_length 40

# pwd
set -g tide_pwd_color_dirs 'blue'
set -g tide_pwd_color_anchors 'blue'
set -g tide_pwd_color_truncated_dirs 'blue'

# time
set -g tide_time_format ' %T'
